# Переменные окружения для разработки


# Режим работы (development / production)
FLASK_ENV=development

# Секретный ключ JWT. Задайте свое значение локально, не коммитьте реальные секреты.
JWT_SECRET_KEY=


DATABASE_URL=sqlite:///flask_auth.db

# Хост и порт
HOST=0.0.0.0
PORT=5001

# Локальные тестовые пользователи.
# Пароли задавайте только в своем .env, не коммитьте реальные значения.
ADMIN_EMAIL=
ADMIN_PASSWORD=
MANAGER_EMAIL=
MANAGER_PASSWORD=
CASHIER_EMAIL=
CASHIER_PASSWORD=
CLIENT_EMAIL=
CLIENT_PASSWORD=
